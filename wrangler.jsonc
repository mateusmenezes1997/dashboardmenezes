{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "dashboardmenezes",
  "workers_dev": true,
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./.cloudflare-public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "gestao-menezes-db",
    "database_id": "14b8c10f-0290-4bd0-9fad-daba4808701c"
  }]
}
